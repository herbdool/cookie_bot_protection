<?php

/**
 * @file
 * Cookie Bot Protection
 */

use Symfony\Component\HttpFoundation\IpUtils;

/**
 * The challenge cookie name.
 */
define('COOKIE_BOT_PROTECTION_COOKIE_NAME', 'SESScookiebotprotection');

/**
 * Implements hook_autoload_info().
 */
function cookie_bot_protection_autoload_info() {
  return [
    'Symfony\Component\HttpFoundation\IpUtils' => 'IpUtils/IpUtils.php',
  ];
}

/**
 * Implements hook_config_info().
 */
function cookie_bot_protection_config_info() {
  $prefixes['cookie_bot_protection.settings'] = array(
    'label' => t('Cookie Bot Protection'),
    'group' => t('Configuration'),
  );
  return $prefixes;
}

/**
 * Implements hook_menu().
 */
function cookie_bot_protection_menu() {
  $items['admin/config/cookie_bot_protection/settings'] = [
    'title' => 'Cookie Bot Protection',
    'page callback' => 'backdrop_get_form',
    'page arguments' => ['cookie_bot_protection_settings_form'],
    'access arguments' => ['administer cookie bot protection'],
    'file' => 'cookie_bot_protection.admin.inc',
  ];

  return $items;
}

/**
 * Implements hook_permission().
 */
function cookie_bot_protection_permission() {
  $permissions['administer cookie bot protection'] = [
    'title' => t('Administer Cookie Bot Protection settings'),
    'description' => t('Allow users to modify the settings of the Cookie Bot Protection module.'),
  ];

  return $permissions;
}

/**
 * Get request data
 *
 * @return object
 */
function _cookie_bot_protection_get_request() {
  $url = request_path();
  if (module_exists('language')) {
    list($language, $url) = language_url_split_prefix($url, language_list(TRUE));
  }
  return (object) array(
    'uri' => $url,
    'query_parameters' => backdrop_get_query_parameters(),
    'method' => $_SERVER['REQUEST_METHOD'],
    'ip' => ip_address(),
    'headers' => cookie_bot_protection_get_all_headers(),
  );
}

/**
 * Implements hook_init().
 */
function cookie_bot_protection_init() {
  // Get the global Request object.
  $request = _cookie_bot_protection_get_request();

  // Backdrop runs init for every page request (including sub‑requests);
  // skip AJAX, CLI, etc.
  if (backdrop_is_cli() || backdrop_is_background() || backdrop_is_ajax() || backdrop_is_dialog() || user_is_logged_in()) {
    return;
  }

  if (!cookie_bot_protection_is_needed($request)) {
    return;
  }

  // Challenge logic
  $hours = [
    new BackdropDateTime(),
    (new BackdropDateTime())->add(new \DateInterval('PT1H')),
  ];
  $salt = (string) settings_get('hash_salt', '');
  $challenge_param = $request->query_parameters['backdrop_cbp_check'] ?? 0;

  $request_challenge = $_COOKIE[COOKIE_BOT_PROTECTION_COOKIE_NAME] ?? NULL;

  $challenges = $challenges_auth = [];
  $hash_payload_current = NULL;
  foreach ($hours as $hour) {
    $hash_payload = cookie_bot_protection_hash_payload($request, $hour);
    $hash_payload_current ??= $hash_payload;
    $challenges_auth[] = hash_hmac('sha256', $hash_payload . 'checked', $salt);
    $challenges[]      = hash_hmac('sha256', $hash_payload . 'unchecked', $salt);
  }

  $response = NULL;
  if ($challenge_param == '1') {
    if (in_array($request_challenge, $challenges, TRUE)) {
      list($response, $request) = cookie_bot_protection_authorize($request, $challenges_auth[0]);
    }
    elseif (in_array($request_challenge, $challenges_auth, TRUE)) {
      unset($request->query_parameters['backdrop_cbp_check']);
      $response = (object) [
        'type' => 'redirect',
        'content' => '',
      ];
    }
    else {
      list($response, $request) = cookie_bot_protection_deny($request);
    }
  }
  elseif (!in_array($request_challenge, $challenges_auth)) {
    list($response, $request) = cookie_bot_protection_challenge($request, $challenges[0]);
  }

  if ($response) {
    // Add optional debug headers.
    if (config('cookie_bot_protection.settings')->get('header_response_debug')) {
      $headers = [
        'Backdrop-CBP-Debug' => 'TRUE',
        'Backdrop-CBP-Date'  => (new BackdropDateTime())->format('c.v'),
        'Backdrop-CBP-Request-Challenge' => $request_challenge,
        'Backdrop-CBP-Challenges' => serialize($challenges),
        'Backdrop-CBP-Checked-Challenges' => serialize($challenges_auth),
        'Backdrop-CBP-Checked-Query' => $challenge_param,
        'Backdrop-CBP-Request-Headers' => $hash_payload_current,
      ];
      foreach ($headers as $header_name => $header_value) {
    	  backdrop_add_http_header($header_name, $header_value);
      }
    }

    // Ensure non‑caching.
    backdrop_add_http_header('Cache-Control', 'no-cache, no-store, must-revalidate, public, max-age=0');

    switch ($response->type) {
      case 'challenge':
      case 'redirect':
      case 'authorize':
        $url = url($request->uri, array('absolute' => TRUE, 'query' => $request->query_parameters));
        cookie_bot_protection_redirect_target($url);
        break;
      case 'deny':
        print $response->content;
        exit();
        break;
    }
  }
}

/**
 * Build the hash payload from the request and date.
 *
 * @param object $request
 *   The current request.
 * @param BackdropDateTime $date
 *   The date used to scope the hash to a specific hour.
 *
 * @return string
 *   JSON-encoded payload used as HMAC input.
 */
function cookie_bot_protection_hash_payload(object $request, BackdropDateTime $date) {
  $hash_headers = [
    'accept_language' => $request->headers['Accept-Language'] ?? NULL,
    'user_agent' => $request->headers['User-Agent'] ?? NULL,
    'ip' => $request->ip ?? NULL,
    'date' => $date->format('Y-m-d H'),
  ];

  return json_encode($hash_headers);
}

/**
 * Check if the challenge needs to be performed.
 *
 * @param object $request
 *   The current request.
 *
 * @return bool
 *   TRUE if the challenge needs to be performed, FALSE otherwise.
 *
 * @throws \Exception
 */
function cookie_bot_protection_is_needed(object $request) {
    if (!cookie_bot_protection_is_needed_urls($request)) {
      return FALSE;
    }

    if (cookie_bot_protection_is_ua_whitelisted($request)) {
      return FALSE;
    }

    if (cookie_bot_protection_is_ip_whitelisted($request)) {
      return FALSE;
    }

    return TRUE;
  }

/**
 * Check if the current url is covered by the cookie protection.
 *
 * @param object $request
 *   The current request.
 *
 * @return bool
 *   TRUE if the current url is part of the protected page list.
 */
function cookie_bot_protection_is_needed_urls(object $request) {
  $patterns = config('cookie_bot_protection.settings')->get('url_protected_patterns');
  if (empty($patterns)) {
    return FALSE;
  }
  $uri = $request->uri;
  foreach ($patterns as $p) {
    $p = preg_replace('/\\\\u([a-fA-F0-9]{4})/', '\\x{\\1}', (string) $p);
    if (preg_match('{' . $p . '}u', $uri)) {
      return TRUE;
    }
  }
  return FALSE;
}

/**
 * Check if the User-Agent is whitelisted.
 *
 * @param object $request
 *   The current request.
 *
 * @return bool
 *   TRUE if the User-Agent is whitelisted, FALSE otherwise.
 */
function cookie_bot_protection_is_ua_whitelisted(object $request) {
  $ua_whitelist = config('cookie_bot_protection.settings')->get('ua_whitelist_patterns');
  if (empty($ua_whitelist)) {
    return FALSE;
  }

  $user_agent = $request->headers['User-Agent'];
  foreach ($ua_whitelist as $url_pattern) {
    $pcre_pattern = preg_replace('/\\\\u([a-fA-F0-9]{4})/', '\\x{\\1}', (string) $url_pattern);
    if (preg_match('{' . $pcre_pattern . '}u', (string) $user_agent) > 0) {
      return TRUE;
    }
  }

  return FALSE;
}

/**
 * Check if the IP is whitelisted.
 *
 * @param object $request
 *   The current request.
 *
 * @return bool
 *   TRUE if the IP is in the whitelist, FALSE otherwise.
 */
function cookie_bot_protection_is_ip_whitelisted(object $request) {
  $ip_whitelist = config('cookie_bot_protection.settings')->get('ip_whitelist');
  if (empty($ip_whitelist)) {
    return FALSE;
  }

  return _cookie_bot_protection_check_ip($request->ip, $ip_whitelist);
}

/**
 * Get all headers
 *
 * @return array
 *   Array of all headers.
 */
function cookie_bot_protection_get_all_headers() {
  if (function_exists('getallheaders')) {
    $headers = getallheaders();
  }
  else {
    // Fallback for non‑Apache SAPI (e.g. CGI/FPM).
    $headers = [];
    foreach ($_SERVER as $key => $value) {
      if (strpos($key, 'HTTP_') === 0) {
        // Convert "HTTP_ACCEPT_LANGUAGE" - "Accept-Language".
        $header = str_replace(' ', '-', ucwords(strtolower(str_replace('_', ' ', substr($key, 5)))));
        $headers[$header] = $value;
      }
      // Some servers expose Content-Type and Content-Length without the
      // HTTP_ prefix.
      elseif (in_array($key, ['CONTENT_TYPE', 'CONTENT_LENGTH'])) {
        $header = str_replace('_', '-', ucwords(strtolower($key)));
        $headers[$header] = $value;
      }
    }
  }

  return $headers;
}

/**
 * Create cookie
 *
 * @param string $cookie_value
 */
function _cookie_bot_protection_create_cookie(string $cookie_value) {
  global $cookie_domain, $is_https;

  $cookie_parts = [
    rawurlencode(COOKIE_BOT_PROTECTION_COOKIE_NAME) . '=' . rawurlencode($cookie_value),
    'Path=/',
  ];

  $cookie_parts[] = 'Domain=' . $cookie_domain;

  if ($is_https) {
    $cookie_parts[] = 'Secure';
  }
  $cookie_parts[] = 'HttpOnly';

  // @todo see https://git.drupalcode.org/project/cookie_bot_protection/-/work_items/3595590
  $cookie_parts[] = 'SameSite=Lax';

  $set_cookie_header = implode('; ', $cookie_parts);

  backdrop_add_http_header('Set-Cookie', $set_cookie_header);
}

/**
 * Sync the request‑object query parameters to PHP’s super‑globals.
 *
 * @param object $request
 *   The request whose query collection has just been altered.
 *
 * @return void
 *   Updates $_GET and $_REQUEST in place.
 */
function _cookie_bot_protection_override_query_globals(object $request) {
  $new_query = $request->query_parameters;

  $_GET = $new_query;

  // Re‑build $_REQUEST. In PHP the default order for REQUEST variables
  // is GET → POST → COOKIE, so start with the (now‑updated) GET array
  // and then merge any existing POST and COOKIE data that might already
  // be present.
  $_REQUEST = array_merge($_GET, $_POST, $_COOKIE);
}

/**
 * Prepare the redirect to the challenge and set the corresponding cookie.
 *
 * @param object $request
 *   The current request.
 * @param string $challenge
 *   The redirect challenge to set to a cookie.
 *
 * @return array
 *   Array of response type and request object.
 */
function cookie_bot_protection_challenge(object $request, string $challenge) {
  $request->query_parameters['backdrop_cbp_check'] = '1';
  _cookie_bot_protection_create_cookie($challenge);
  _cookie_bot_protection_override_query_globals($request);

  $response = (object) [
    'type' => 'challenge',
    'content' => '',
  ];

  return [$response, $request];
}

/**
   * Return the authorize response and set cookie.
   *
   * @param object $request
   *   The current request.
   * @param string $challenge
   *   The authorization to set to a cookie.
   *
   * @return array
   *   Array of response type and request object.
   */
function cookie_bot_protection_authorize(object $request, string $challenge) {
  $request->query_parameters['backdrop_cbp_check'] = '1';
  _cookie_bot_protection_create_cookie($challenge);
  _cookie_bot_protection_override_query_globals($request);

  $response = (object) [
    'type' => 'authorize',
    'content' => '',
  ];

  return [$response, $request];
}

/**
 * Deny
 *
 * @param object $request
 *   The current request.
 *
 * @return array
 *   Array of response and request objects.
 */
function cookie_bot_protection_deny(object $request) {
  $message = 'Cookie bot protection: access denied for IP @ip (UA: @ua)';
  $context = [
    '@ip' => $request->ip,
    '@ua' => substr((string) ($request->headers['User-Agent'] ?? ''), 0, 128),
  ];
  watchdog('cookie_bot_protection', $message, $context, WATCHDOG_WARNING);

  $redirect_error_delay = (int) config('cookie_bot_protection.settings')->get('redirect_error_delay');

  backdrop_add_http_header('Status', '401 Unauthorized');

  $content = '<h1>Excessive crawling detected</h1><p>We have blocked your request.</p>';

  _backdrop_session_delete_cookie(COOKIE_BOT_PROTECTION_COOKIE_NAME);

  // Allow retry if eventually the challenge was still on a legitimate
  // user request.
  if ($redirect_error_delay > 0) {
    unset($request->query_parameters['backdrop_cbp_check']);

    // Build the Refresh header.
    $refresh_header = sprintf(
      '%d; url=%s',
      $redirect_error_delay,
      url($request->uri, array('absolute' => TRUE)),
    );
    backdrop_add_http_header('Refresh', $refresh_header);

    $content = '<h1>Excessive crawling detected</h1><p>We have blocked your request. This page will refresh to recheck.</p>';
  }

  $response = (object) [
    'type' => 'deny',
    'content' => $content,
  ];

  return [$response, $request];
}

/**
 * Sets the redirect target of this response.
 *
 * @param string $url
 *
 * @throws \InvalidArgumentException
 */
function cookie_bot_protection_redirect_target(string $url) {
  if ('' === $url) {
    throw new \InvalidArgumentException('Cannot redirect to an empty URL.');
  }

  $content = sprintf('<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8" />
        <meta http-equiv="refresh" content="0;url=\'%1$s\'" />

        <title>Redirecting to %1$s</title>
    </head>
    <body>
        Redirecting to <a href="%1$s">%1$s</a>.
    </body>
</html>', htmlspecialchars($url, \ENT_QUOTES, 'UTF-8'));

  backdrop_add_http_header('Location', $url);
  backdrop_add_http_header('Content-Type', 'text/html; charset=utf-8');
  print $content;
  backdrop_exit();
}

/**
 * Checks if an IPv4 or IPv6 address is contained in the list of given IPs or
 * subnets.
 *
 * @param string|array $ips
 *   List of IPs or subnets (can be a string if only a single one).
 *
 * @return bool
 *   TRUE if IP address is in the list, FALSE otherwise.
 */
function _cookie_bot_protection_check_ip(string $request_ip, string|array $ips) {
  if (!is_array($ips)) {
    $ips = [$ips];
  }

  $method = substr_count($request_ip, ':') > 1 ? 'checkIp6' : 'checkIp4';

  foreach ($ips as $ip) {
    if (IpUtils::$method($request_ip, $ip)) {
      return true;
    }
  }

  return false;
}
